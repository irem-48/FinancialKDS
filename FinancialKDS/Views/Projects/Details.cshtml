@model Project
@using System.Text.Json

@{
    ViewData["Title"] = "Proje Detayı";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.ProjectName</h2>
        <p class="text-muted mb-0">@Model.Description</p>
    </div>

    <div>
        @if (Model.AnalysisResult != null)
        {
            <button onclick="window.print()" class="btn btn-outline-dark me-2">
                Analiz Raporunu Yazdır
            </button>
        }

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">
            Düzenle
        </a>

        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger me-2">
            Sil
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Projelere Dön
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card mt-4">
    <div class="card-header bg-dark text-white">
        Proje Bilgileri
    </div>

    <div class="card-body">
        <p><strong>İlk Yatırım Maliyeti:</strong> @Model.InitialInvestment.ToString("N2") TL</p>
        <p><strong>İskonto Oranı:</strong> %@Model.DiscountRate</p>
        <p><strong>Tahmin Edilecek Dönem:</strong> @Model.ForecastPeriod dönem</p>
        <p><strong>Oluşturulma Tarihi:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h3>Geçmiş Nakit Akışları</h3>

    <a asp-controller="CashFlows" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary">
        Nakit Akışı Ekle
    </a>
</div>

@if (Model.CashFlows == null || !Model.CashFlows.Any())
{
    <div class="alert alert-warning">
        Bu proje için henüz nakit akışı verisi girilmemiş.
    </div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Dönem</th>
                <th>Nakit Akışı</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cashFlow in Model.CashFlows.OrderBy(c => c.Period))
            {
                <tr>
                    <td>@cashFlow.Period</td>
                    <td>@cashFlow.Amount.ToString("N2") TL</td>
                    <td>
                        <a asp-controller="CashFlows"
                           asp-action="Delete"
                           asp-route-id="@cashFlow.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bu nakit akışını silmek istediğine emin misin?');">
                            Sil
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4">
        <a asp-action="Analyze" asp-route-id="@Model.Id" class="btn btn-success btn-lg">
            Analiz Et
        </a>
    </div>
}

@if (Model.AnalysisResult != null)
{
    <hr class="my-5" />

    <h3>Analiz Sonucu</h3>

    <div class="row mt-3">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    Regresyon Katsayıları
                </div>
                <div class="card-body">
                    <p><strong>β₀:</strong> @Model.AnalysisResult.Beta0</p>
                    <p><strong>β₁:</strong> @Model.AnalysisResult.Beta1</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    NPV Sonucu
                </div>
                <div class="card-body">
                    <h4>@Model.AnalysisResult.NPV.ToString("N2") TL</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-dark">
                <div class="card-header bg-dark text-white">
                    Karar
                </div>
                <div class="card-body">
                    <p>@Model.AnalysisResult.Decision</p>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.ForecastResults != null && Model.ForecastResults.Any())
{
    <h3 class="mt-5">Tahmini Nakit Akışları</h3>

    <table class="table table-bordered table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Dönem</th>
                <th>Tahmini Nakit Akışı</th>
                <th>Bugünkü Değer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in Model.ForecastResults.OrderBy(f => f.Period))
            {
                <tr>
                    <td>@forecast.Period</td>
                    <td>@forecast.PredictedCashFlow.ToString("N2") TL</td>
                    <td>@forecast.PresentValue.ToString("N2") TL</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.ForecastResults != null && Model.ForecastResults.Any())
{
    var orderedCashFlows = Model.CashFlows.OrderBy(c => c.Period).ToList();
    var orderedForecasts = Model.ForecastResults.OrderBy(f => f.Period).ToList();

    var chartLabels = orderedCashFlows
        .Select(c => "Dönem " + c.Period)
        .Concat(orderedForecasts.Select(f => "Dönem " + f.Period))
        .ToList();

    var actualData = orderedCashFlows
        .Select(c => (double?)c.Amount)
        .Concat(orderedForecasts.Select(f => (double?)null))
        .ToList();

    var forecastData = orderedCashFlows
        .Select(c => (double?)null)
        .Concat(orderedForecasts.Select(f => (double?)f.PredictedCashFlow))
        .ToList();

    <h3 class="mt-5">Nakit Akışı Tahmin Grafiği</h3>

    <div class="card mt-3 mb-5 print-chart-card">
        <div class="card-body">
            <canvas id="cashFlowChart" height="90"></canvas>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const chartLabels = @Html.Raw(JsonSerializer.Serialize(chartLabels));
        const actualData = @Html.Raw(JsonSerializer.Serialize(actualData));
        const forecastData = @Html.Raw(JsonSerializer.Serialize(forecastData));

        const ctx = document.getElementById('cashFlowChart');

        const cashFlowChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        label: 'Geçmiş Nakit Akışı',
                        data: actualData,
                        borderWidth: 2,
                        tension: 0.3
                    },
                    {
                        label: 'Tahmini Nakit Akışı',
                        data: forecastData,
                        borderWidth: 2,
                        borderDash: [6, 6],
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Geçmiş ve Tahmini Nakit Akışları'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        title: {
                            display: true,
                            text: 'Tutar (TL)'
                        }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Dönem'
                        }
                    }
                }
            }
        });
        window.addEventListener('beforeprint', () => {
            cashFlowChart.resize(700, 260);
        });

        window.addEventListener('afterprint', () => {
            cashFlowChart.resize();
        });
    </script>
}