@model List<Project>

@{
    ViewData["Title"] = "Projeler";

    var totalProjects = Model.Count;
    var totalInvestment = Model.Sum(p => p.InitialInvestment);
    var averageDiscountRate = Model.Any() ? Model.Average(p => p.DiscountRate) : 0;
    var totalForecastPeriod = Model.Sum(p => p.ForecastPeriod);
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-4">
        <h1 class="display-5 fw-bold">Finansal Karar Destek Sistemi</h1>

        <p class="col-md-9 fs-5 text-muted">
            Bu sistem, yatırım projelerinin fizibilite analizini gerçekleştirmek için geçmiş nakit akışlarını
            doğrusal regresyon yöntemiyle analiz eder, gelecek dönem tahminleri üretir ve Net Bugünkü Değer
            (NPV) hesaplamasıyla yatırım kararını destekler.
        </p>

        <a asp-action="Create" class="btn btn-primary btn-lg mt-2">
            Yeni Proje Oluştur
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row mb-5 g-3">
    <div class="col-md-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h6 class="text-muted">Toplam Proje</h6>
                <h3 class="fw-bold">@totalProjects</h3>
                <p class="mb-0 text-muted">Sisteme kayıtlı yatırım projesi</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <h6 class="text-muted">Toplam Yatırım</h6>
                <h4 class="fw-bold">@totalInvestment.ToString("N2") TL</h4>
                <p class="mb-0 text-muted">Projelerin toplam başlangıç maliyeti</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h6 class="text-muted">Ortalama İskonto</h6>
                <h3 class="fw-bold">%@averageDiscountRate.ToString("N2")</h3>
                <p class="mb-0 text-muted">Projelerde kullanılan ortalama oran</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-dark h-100">
            <div class="card-body">
                <h6 class="text-muted">Tahmin Dönemi</h6>
                <h3 class="fw-bold">@totalForecastPeriod</h3>
                <p class="mb-0 text-muted">Toplam analiz edilecek dönem sayısı</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Yatırım Projeleri</h2>
        <p class="text-muted mb-0">
            Oluşturulan yatırım projelerini görüntüleyebilir, detaylarını inceleyebilir ve analiz sürecini başlatabilirsin.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-outline-primary">
        + Yeni Proje
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        Henüz proje oluşturulmamış. İlk fizibilite analizini başlatmak için yeni proje oluştur.
    </div>
}
else
{
    <div class="card mt-4">
        <div class="card-header bg-dark text-white">
            Proje Listesi
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Proje Adı</th>
                            <th>İlk Yatırım</th>
                            <th>İskonto Oranı</th>
                            <th>Tahmin Dönemi</th>
                            <th>Oluşturulma Tarihi</th>
                            <th>NPV</th>
                            <th>Durum</th>
                            <th class="text-center">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@project.ProjectName</strong>

                                    @if (!string.IsNullOrWhiteSpace(project.Description))
                                    {
                                        <br />
                                        <small class="text-muted">@project.Description</small>
                                    }
                                </td>

                                <td>@project.InitialInvestment.ToString("N2") TL</td>
                                <td>%@project.DiscountRate.ToString("N2")</td>
                                <td>@project.ForecastPeriod dönem</td>
                                <td>@project.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>

                                <td>
                                    @if (project.AnalysisResult != null)
                                    {
                                        <strong>@project.AnalysisResult.NPV.ToString("N2") TL</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @if (project.AnalysisResult == null)
                                    {
                                        <span class="badge bg-secondary">
                                            Analiz Bekliyor
                                        </span>
                                    }
                                    else if (project.AnalysisResult.NPV > 0)
                                    {
                                        <span class="badge bg-success">
                                            Kabul Edilebilir
                                        </span>
                                    }
                                    else if (project.AnalysisResult.NPV < 0)
                                    {
                                        <span class="badge bg-danger">
                                            Uygun Değil
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Başa Baş
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@project.Id"
                                           class="btn btn-sm btn-primary">
                                            Detay
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@project.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Düzenle
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@project.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}