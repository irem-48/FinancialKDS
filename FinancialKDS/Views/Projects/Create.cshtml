@model Project

@{
    ViewData["Title"] = "Yeni Proje";
}

<h2>Yeni Yatırım Projesi Oluştur</h2>

<p class="text-muted">
    Proje bilgilerini girerek fizibilite analizi için temel verileri oluştur.
</p>

<form asp-action="Create" method="post" class="mt-4">
    <div class="mb-3">
        <label asp-for="ProjectName" class="form-label"></label>
        <input asp-for="ProjectName" class="form-control" placeholder="Örn: Yeni Şube Yatırımı" />
        <span asp-validation-for="ProjectName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Proje hakkında kısa açıklama"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="InitialInvestment" class="form-label"></label>
        <input asp-for="InitialInvestment" class="form-control" placeholder="Örn: 500000" />
        <span asp-validation-for="InitialInvestment" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiscountRate" class="form-label"></label>
        <input asp-for="DiscountRate" class="form-control" placeholder="Örn: 18" />
        <span asp-validation-for="DiscountRate" class="text-danger"></span>
        <small class="text-muted">Yüzde olarak gir. Örneğin %18 için 18 yaz.</small>
    </div>

    <div class="mb-3">
        <label asp-for="ForecastPeriod" class="form-label"></label>
        <input asp-for="ForecastPeriod" class="form-control" placeholder="Örn: 5" />
        <span asp-validation-for="ForecastPeriod" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}