<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinancialKDS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 1.5cm;
            }

            nav,
            footer,
            .btn {
                display: none !important;
            }

            body {
                background: white !important;
                font-size: 11px !important;
            }

            main.container {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            h2, h3 {
                font-size: 18px !important;
                margin-top: 12px !important;
                margin-bottom: 10px !important;
            }

            .card {
                border: 1px solid #000 !important;
                box-shadow: none !important;
                page-break-inside: avoid;
            }

            table {
                width: 100% !important;
                font-size: 10px !important;
                page-break-inside: avoid;
            }

            .table th,
            .table td {
                padding: 4px !important;
            }

            .row {
                display: block !important;
            }

            .col-md-4 {
                width: 100% !important;
                max-width: 100% !important;
                margin-bottom: 8px !important;
            }

            .print-chart-card {
                width: 100% !important;
                max-width: 100% !important;
                page-break-inside: avoid;
                overflow: hidden !important;
            }

            #cashFlowChart {
                width: 100% !important;
                max-width: 100% !important;
                height: 260px !important;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Projects" asp-action="Index">
                FinancialKDS
            </a>

            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Projects" asp-action="Index">Projeler</a>
                <a class="nav-link" asp-controller="Projects" asp-action="Create">Yeni Proje</a>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="border-top mt-5 py-3 text-center text-muted">
        <small>© 2026 - FinancialKDS Karar Destek Sistemi</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>