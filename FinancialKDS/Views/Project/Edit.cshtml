@model FinancialKDS.Models.Project

@{
    ViewData["Title"] = "Projeyi Düzenle";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <h4 class="fw-bold mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Projeyi Düzenle
                    </h4>
                    <p class="small opacity-75 mb-0">Proje parametrelerini ve fizibilite verilerini güncelleyin.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Proje Adı</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="InitialInvestment" class="form-label fw-semibold">İlk Yatırım Maliyeti (TL)</label>
                                <input asp-for="InitialInvestment" class="form-control" type="text" value="@Model.InitialInvestment.ToString("0.##")" required />
                                <span asp-validation-for="InitialInvestment" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DiscountRate" class="form-label fw-semibold">İskonto Oranı (%)</label>
                                <input asp-for="DiscountRate" class="form-control" type="text" value="@Model.DiscountRate.ToString("0.##")" required />
                                <span asp-validation-for="DiscountRate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ForecastPeriods" class="form-label fw-semibold">Tahmin Dönemi Sayısı</label>
                            <input asp-for="ForecastPeriods" class="form-control" type="number" required />
                            <span asp-validation-for="ForecastPeriods" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">İptal</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>