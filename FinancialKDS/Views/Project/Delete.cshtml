@model FinancialKDS.Models.Project

@{
    ViewData["Title"] = "Proje Sil";
}

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-danger">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold text-danger mb-0">Proje Silme Onayı</h4>
                </div>
                <div class="card-body">
                    <p class="text-dark">Bu projeyi ve projeye ait tüm nakit akış verilerini silmek istediğinize emin misiniz?</p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Proje Adı:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-4">İlk Yatırım:</dt>
                        <dd class="col-sm-8">@Model.InitialInvestment.ToString("N2") TL</dd>

                        <dt class="col-sm-4">İskonto Oranı:</dt>
                        <dd class="col-sm-8">%@Model.DiscountRate</dd>

                        <dt class="col-sm-4">Tahmin Dönemi:</dt>
                        <dd class="col-sm-8">@Model.PeriodsToForecast Dönem</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Evet, Sil</button>
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>