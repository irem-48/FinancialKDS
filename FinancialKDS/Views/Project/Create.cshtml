@model FinancialKDS.Models.Project

@{
    ViewData["Title"] = "Yeni Proje Oluştur";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <h4 class="fw-bold mb-0">
                        <i class="bi bi-folder-plus me-2"></i>Yeni Yatırım Projesi Oluştur
                    </h4>
                    <p class="small opacity-75 mb-0">Proje bilgilerini girerek fizibilite analizi için temel verileri oluşturun.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Proje Adı</label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Yeni Fabrika Yatırımı" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Proje hakkında kısa açıklama"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="InitialInvestment" class="form-label fw-semibold">İlk Yatırım Maliyeti (TL)</label>
                                <input asp-for="InitialInvestment" class="form-control" type="number" step="any" placeholder="Örn: 5000000" required />
                                <span asp-validation-for="InitialInvestment" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DiscountRate" class="form-label fw-semibold">İskonto Oranı (%)</label>
                                <input asp-for="DiscountRate" class="form-control" type="number" step="any" placeholder="Örn: 15" required />
                                <span asp-validation-for="DiscountRate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ForecastPeriods" class="form-label fw-semibold">Tahmin Dönemi Sayısı</label>
                            <input asp-for="ForecastPeriods" class="form-control" type="number" value="5" placeholder="Örn: 5" required />
                            <span asp-validation-for="ForecastPeriods" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">İptal</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Kaydet ve Devam Et
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>s