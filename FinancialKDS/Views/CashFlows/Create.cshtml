@model FinancialKDS.Models.CashFlow

@{
    ViewData["Title"] = "Nakit Akışı Ekle";
    var project = ViewBag.Project as FinancialKDS.Models.Project;
}

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0">Nakit Akışı Ekle</h4>
                    @if (project != null)
                    {
                        <small class="text-muted">Proje: <strong>@project.Name</strong></small>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="ProjectId" />

                        <div class="mb-3">
                            <label asp-for="Period" class="form-label fw-bold">Dönem (Yıl / Ay)</label>
                            <input asp-for="Period" class="form-control" placeholder="Örn: 1" />
                            <span asp-validation-for="Period" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold">Nakit Akışı Tutarı (TL)</label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="Örn: 150000" />
                            <small class="text-muted d-block mt-1">Gerekirse negatif nakit akışı (zarar) girebilirsiniz.</small>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Ekle</button>
                            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}