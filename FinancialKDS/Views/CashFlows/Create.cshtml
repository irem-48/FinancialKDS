@model CashFlow

@{
    ViewData["Title"] = "Nakit Akışı Ekle";
    var project = ViewBag.Project as Project;
}

<h2>Nakit Akışı Ekle</h2>

@if (project != null)
{
    <p class="text-muted">
        Proje: <strong>@project.ProjectName</strong>
    </p>
}

<form asp-action="Create" method="post" class="mt-4">
    <input type="hidden" asp-for="ProjectId" />

    <div class="mb-3">
        <label asp-for="Period" class="form-label"></label>
        <input asp-for="Period" class="form-control" placeholder="Örn: 1" />
        <span asp-validation-for="Period" class="text-danger"></span>
        <small class="text-muted">Dönemi sayısal gir. Örneğin 1, 2, 3...</small>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" placeholder="Örn: 120000" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>

    @if (project != null)
    {
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-secondary">
            Geri Dön
        </a>
    }
</form>